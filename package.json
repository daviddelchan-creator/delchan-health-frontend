{
  "name": "medplum-nextjs-demo",
  "version": "5.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('.next')) fs.rmSync('.next', { recursive: true, force: true });\"",
    "dev": "npm run clean && next dev",
    "start": "next start",
    "test:backend": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest app/api/patient"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@mantine/charts": "^9.5.2",
    "@mantine/core": "8.3.7",
    "@mantine/hooks": "8.3.7",
    "@mantine/notifications": "8.3.7",
    "@mantine/tiptap": "^8.3.18",
    "@medplum/core": "5.0.4",
    "@medplum/react": "5.0.4",
    "@medplum/react-hooks": "^4.5.2",
    "@next/bundle-analyzer": "15.5.6",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/qrcode": "^1.5.6",
    "date-fns": "^4.4.0",
    "googleapis": "^176.0.0",
    "jsqr": "^1.4.0",
    "next": "15.5.6",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "rfc6902": "5.1.2"
  },
  "devDependencies": {
    "@medplum/fhirtypes": "5.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "22.19.1",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.6",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
